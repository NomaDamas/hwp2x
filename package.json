{
  "name": "hwp2x",
  "version": "0.4.0-rc.7",
  "private": true,
  "author": "hwp2x <chloveyou@gmail.com>",
  "description": "로컬 HWP 파일을 HWPX로 일괄 변환하는 Electron 앱",
  "main": "electron/dist/main.js",
  "scripts": {
    "build": "tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "test": "npm run build && node --test electron/dist/engine.test.js electron/dist/cleanup.test.js electron/dist/automatic.test.js electron/dist/origin.test.js electron/dist/hancom.test.js electron/dist/logger.test.js electron/dist/report.test.js electron/folder-start.test.cjs",
    "dist": "npm test && electron-builder --win nsis portable --linux deb --publish never && npm run dist:win32",
    "dist:win32": "electron-builder --win nsis portable --ia32 --publish never -c.nsis.artifactName=\"hwp2x Setup \\${version}-ia32.exe\" -c.directories.output=dist-electron/ia32",
    "build:native": "cd electron/native && uv run --no-project --with ziglang python -m ziglang cc -target x86-windows-gnu -shared -Os -nostdlib -Wl,--entry,DllMain@12 -o x86/FilePathCheckerModule.dll FilePathCheckerModule.c FilePathCheckerModule.def && uv run --no-project --with ziglang python -m ziglang cc -target x86_64-windows-gnu -shared -Os -nostdlib -Wl,--entry,DllMain -o x64/FilePathCheckerModule.dll FilePathCheckerModule.c && rm -f x86/*.lib x86/*.pdb x64/*.lib x64/*.pdb"
  },
  "build": {
    "appId": "dev.hwp2x.app",
    "productName": "hwp2x",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/dist/**",
      "!electron/dist/*.test.js",
      "electron/design/**",
      "!electron/design/hwp2x-2-App.dc.html",
      "electron/icons/icon.png",
      "package.json",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/onnxruntime-common/**",
      "!node_modules/@huggingface/**",
      "!node_modules/@hyzyla/**",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/react-dom/**",
      "!node_modules/@modelcontextprotocol/**",
      "!node_modules/zod/**",
      "!node_modules/hono/**",
      "!node_modules/ajv/**",
      "!node_modules/typescript/**",
      "!node_modules/playwright/**",
      "!node_modules/playwright-core/**",
      "!node_modules/@napi-rs/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "electron/icons/png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "portable": {
      "artifactName": "hwp2x-${version}-portable-${arch}.exe",
      "useZip": true,
      "splashImage": "electron/icons/portable-splash.bmp"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "electron/native/x86/FilePathCheckerModule.dll",
        "to": "hancom/x86/FilePathCheckerModule.dll"
      },
      {
        "from": "electron/native/x64/FilePathCheckerModule.dll",
        "to": "hancom/x64/FilePathCheckerModule.dll"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "1.58.2",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "electron@41.10.7": true
  },
  "dependencies": {
    "kordoc": "4.24.42",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
